PORT=3000
# Sous Docker Compose, cette valeur est remplacée par celle de compose.yaml.
# Hors Docker : mettre les identifiants de MONGO_APP_USER / MONGO_APP_PASSWORD (fichier .env racine).
MONGODB_URI=mongodb://helpup_app:change-me@localhost:27017/helpup?authSource=helpup
JWT_SECRET=remplace-moi-par-une-longue-valeur-aleatoire
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
