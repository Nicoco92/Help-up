# Seul fichier d'environnement du projet (lu par Docker Compose et par Vite).
# Copier vers .env puis remplacer chaque change-me.
# Générer les valeurs avec : openssl rand -hex 24   (JWT : openssl rand -hex 32)
# (hexadécimal = pas de caractère spécial à encoder dans les URI Mongo)
#
# ATTENTION : toute variable qui commence par VITE_ est envoyée au navigateur
# et visible par tout le monde. Ne JAMAIS préfixer un secret par VITE_.

# MongoAtlasDev
MONGODB_URI=example-mongodb-uri

# --- MongoDB ---
# Compte administrateur (créé au premier démarrage, sert à mongo-express)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me

# Compte utilisé par le backend (lecture/écriture sur MONGO_APP_DB uniquement)
MONGO_APP_DB=helpup
MONGO_APP_USER=helpup_app
MONGO_APP_PASSWORD=change-me

# --- mongo-express (http://localhost:8081) ---
ME_USER=admin
ME_PASSWORD=change-me

# --- Backend (API Express) ---
# PORT et MONGODB_URI sont fournis par compose.yaml, inutile de les mettre ici.
# 32 caractères minimum : refusé en production, avertissement en développement (openssl rand -hex 32)
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
# Origine(s) autorisée(s) à appeler l'API (adresse du frontend), séparées par des virgules
CORS_ORIGIN=http://localhost:5173
# Derrière un reverse proxy en production : nombre de proxies (ex. 1). Vide en local.
TRUST_PROXY=

# --- Frontend (Vite) : PUBLIC, aucun secret ---
VITE_API_URL=http://localhost:3000/api
