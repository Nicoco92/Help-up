# Seul fichier d'environnement du projet (lu par Docker Compose et par Vite), le même en dev et en prod.
# Copier vers .env et remplacer chaque change-me (commandes dans le README) :
#   openssl rand -hex 24   pour les mots de passe (hexadécimal : rien à encoder dans l'URI Mongo)
#   openssl rand -hex 32   pour JWT_SECRET
#
# ATTENTION : toute variable qui commence par VITE_ est envoyée au navigateur
# et visible par tout le monde. Ne JAMAIS préfixer un secret par VITE_.

# --- MongoDB ---
# Compte administrateur (créé au premier démarrage, sert à mongo-express)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me

# Compte utilisé par le backend (lecture/écriture sur MONGO_APP_DB uniquement)
MONGO_APP_DB=helpup
MONGO_APP_USER=helpup_app
MONGO_APP_PASSWORD=change-me

# Vide = la base Mongo du compose, avec le compte ci-dessus.
# À remplir seulement pour une autre base, par exemple Atlas : mongodb+srv://...
MONGODB_URI=

# --- mongo-express (développement, http://localhost:8081) ---
ME_USER=admin
ME_PASSWORD=change-me

# --- Backend (API Express) ---
# 32 caractères minimum, sinon l'API refuse de démarrer en production
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
# Origines autorisées (séparées par des virgules). Vide = valeur des fichiers compose :
# http://localhost:5173 en dev, https://helpup.lesfarfadets.net en prod.
CORS_ORIGIN=

# --- Frontend (Vite) : PUBLIC, aucun secret ---
# Développement seulement : en production, nginx sert l'API sur la même origine (/api, fixé dans compose.yaml)
VITE_API_URL=http://localhost:3000/api
