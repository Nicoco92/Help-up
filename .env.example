# Copier vers .env puis remplacer chaque valeur.
# Générer les mots de passe avec : openssl rand -hex 24
# (hexadécimal = pas de caractère spécial à encoder dans les URI Mongo)

# Compte administrateur Mongo (créé au premier démarrage, sert à mongo-express)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me

# Compte utilisé par le backend (lecture/écriture sur MONGO_APP_DB uniquement)
MONGO_APP_DB=helpup
MONGO_APP_USER=helpup_app
MONGO_APP_PASSWORD=change-me

# Connexion à l'interface mongo-express (http://localhost:8081)
ME_USER=admin
ME_PASSWORD=change-me
